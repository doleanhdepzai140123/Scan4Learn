          }
        }
      }
    },
    "Couldn't read the JSON. Copy the whole result exactly as requested.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đọc được JSON. Hãy sao chép toàn bộ kết quả theo mẫu yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 JSON。请按要求的模板复制完整结果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать JSON. Скопируй весь результат по заданному шаблону."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON illisible. Copie tout le résultat selon le modèle demandé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON konnte nicht gelesen werden. Kopiere das gesamte Ergebnis nach Vorgabe."
          }
        }
      }
    },
    "A study pack needs a summary, flashcards and questions with valid answers (answer positions start at 0).": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ học cần tóm tắt, flashcard và câu hỏi có đáp án hợp lệ (vị trí đáp án bắt đầu từ 0)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习包需要摘要、闪卡和带有有效答案的题目（答案位置从 0 开始）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набору нужны конспект, карточки и вопросы с корректными ответами (нумерация ответов с 0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pack d'étude exige un résumé, des cartes et des questions avec des réponses valides (les positions commencent à 0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lernsatz braucht eine Zusammenfassung, Karteikarten und Fragen mit gültigen Antworten (Positionen zählen ab 0)."
          }
        }
      }
    },
    "This library version isn't supported yet.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản thư viện chưa được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持此资料库版本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия библиотеки не поддерживается."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de bibliothèque n'est pas prise en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliotheksversion wird noch nicht unterstützt."
          }
        }
      }
    },
    "Couldn't open the library. The original data is kept. %@": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được thư viện. Dữ liệu gốc vẫn được giữ lại. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开资料库。原数据仍会保留。%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть библиотеку. Исходные данные сохранены. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir la bibliothèque. Les données d'origine sont conservées. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothek konnte nicht geöffnet werden. Die ursprünglichen Daten bleiben erhalten. %@"
          }
        }
      }
    },
    "The library is protected after a read error. Restore your data before saving new lessons.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện đang được bảo vệ sau lỗi đọc. Hãy khôi phục dữ liệu trước khi lưu bài mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取出错后资料库已被保护。请先恢复数据再保存新课程。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека защищена после ошибки чтения. Восстанови данные, прежде чем сохранять новые уроки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque est protégée après une erreur de lecture. Restaure tes données avant d'enregistrer de nouvelles leçons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek ist nach einem Lesefehler geschützt. Stelle deine Daten wieder her, bevor du neue Lektionen speicherst."
          }
        }
      }
    },
    "Add a lesson title and content before saving.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm tên bài và nội dung trước khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前请填写课程标题和内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь название и содержание урока перед сохранением."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un titre et un contenu avant d'enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
