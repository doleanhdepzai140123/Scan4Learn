    "Content is too large. Import a study pack under 1 MB.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung quá lớn. Hãy nhập bộ học dưới 1 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容过大。请导入小于 1 MB 的学习包。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое слишком большое. Импортируй набор меньше 1 МБ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu trop volumineux. Importe un pack de moins de 1 Mo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt zu groß. Importiere einen Lernsatz unter 1 MB."
          }
        }
      }
    },
    "The JSON block is incomplete.": {
      "extractionState": "manual",
